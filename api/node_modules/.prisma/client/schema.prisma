generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Crunch {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  userMainId  String?
  logo        String?
  accentColor String?
  // Cor do texto da pagina publica (hex). Nula usa a cor padrao do tema.
  textColor   String?
  // Chave de uma fonte curada (ver FONT_OPTIONS no front). Nula usa a fonte
  // padrao (Fraunces/Inter) ja carregada pela pagina.
  fontFamily  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  city         String
  road         String
  localZipCode String
  state        String
  complement   String?
  number       String?

  document     String?
  isDemoChurch Boolean @default(false)

  // Assinatura. plan: "FREE" | "PRO". subscriptionStatus: "TRIALING" |
  // "ACTIVE" | "PAST_DUE" | "CANCELED" | "EXPIRED". O direito de acesso PRO
  // e sempre calculado na hora (ver resolveActiveChurchContext), nunca lido
  // cru do status - trialEndsAt vencido derruba o acesso mesmo se o cron
  // de limpeza ainda nao rodou.
  plan                String    @default("FREE")
  subscriptionStatus  String    @default("TRIALING")
  trialEndsAt         DateTime?
  mpSubscriptionId    String?
  // Quando o status virou PAST_DUE pela ultima vez - da uma carencia de
  // PAST_DUE_GRACE_DAYS (ver planConfig.ts) antes de derrubar pro Free, em
  // vez de cortar acesso no primeiro pagamento recusado. Null quando nao
  // esta em PAST_DUE.
  pastDueSince        DateTime?
  // Marca que o lembrete de trial acabando ja foi enviado, pra
  // sendTrialReminders() nao mandar de novo a cada execucao do cron.
  trialReminderSentAt DateTime?

  inviteCode String? @unique

  // Dados de rodape da pagina publica. Todos opcionais - a landing so mostra
  // o que estiver preenchido.
  phone     String?
  whatsapp  String?
  email     String?
  instagram String?
  facebook  String?
  youtube   String?
  website   String?

  users                  User[]
  memberships            ChurchMembership[]
  departments            Department[]
  pastorHistory          PastorMandate[]
  churchRoles            ChurchRole[]
  dailyVerses            DailyVerse[]
  announcements          Announcement[]
  serviceTimes           ServiceTime[]
  devotionals            Devotional[]
  devotionalProgresses   DevotionalProgress[]
  devotionalComments     DevotionalComment[]
  prayerRequests         PrayerRequest[]
  pushSubscriptions      PushSubscription[]
  posts                  Post[]
  rosterMembers          RosterMember[]
  messageTemplates       MessageTemplate[]
  messageRules           MessageRule[]
  messageLogs            MessageLog[]
  birthdayMessageSetting BirthdayMessageSetting?
  serviceAttendances     ServiceAttendance[]
}

model MercadoPagoWebhookNotification {
  id          String   @id
  topic       String
  action      String?
  resourceId  String
  processedAt DateTime @default(now())

  @@index([resourceId])
}

model Post {
  id          String   @id @default(uuid())
  title       String
  body        String?
  imageUrl    String?
  imageKey    String?
  // Link de video (YouTube/Instagram) opcional - mesmo padrao de versiculo
  // e devocional. Nao guardamos o binario do video.
  videoUrl    String?
  isPublic    Boolean  @default(true)
  pinned      Boolean  @default(false)
  publishedAt DateTime @default(now())

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([crunchId, isPublic, publishedAt])
}

model ChurchRole {
  id          String   @id @default(uuid())
  name        String
  description String?
  permissions String[]
  // Alcance do cargo: "CHURCH" vale na igreja toda; "MINISTRY" vale apenas
  // no ministerio de departmentId. Cargo de ministerio exige departmentId.
  scope       String   @default("CHURCH")
  createdAt   DateTime @default(now())

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  membershipRoles MembershipRole[]

  @@index([crunchId])
  @@index([departmentId])
}

model MembershipRole {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  membershipId String
  membership   ChurchMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  churchRoleId String
  churchRole   ChurchRole @relation(fields: [churchRoleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, churchRoleId])
  @@index([membershipId])
  @@index([churchRoleId])
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  phone              String?
  role               String   @default("MEMBER")
  createdAt          DateTime @default(now())
  canManageMembers   Boolean  @default(false)
  mustChangePassword Boolean  @default(false)
  isDemoUser         Boolean  @default(false)
  profileSuggestion  String?
  avatarUrl          String?

  crunchId String?
  crunch   Crunch? @relation(fields: [crunchId], references: [id])

  churchMemberships     ChurchMembership[]
  ledDepartments        Department[]               @relation("Leader")
  assignments           ScheduleAssignment[]
  departmentTasks       DepartmentTask[]
  departmentMemberships UserDepartmentMembership[]
  unavailableDates      UserUnavailableDate[]
  userAuth              UserAuth?
  pushSubscriptions     PushSubscription[]
  songPreferences       UserSongPreference[]
  bibleNotes            UserBibleNote[]
  notifications         AppNotification[]
  dailyVerses           DailyVerse[]
  announcements         Announcement[]
  devotionals           Devotional[]
  devotionalProgresses  DevotionalProgress[]
  devotionalComments    DevotionalComment[]
  prayerRequests        PrayerRequest[]
  posts                 Post[]
  rosterMember          RosterMember?
}

model ChurchMembership {
  id               String   @id @default(uuid())
  role             String   @default("MEMBER")
  canManageMembers Boolean  @default(false)
  isPrimary        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  membershipRoles MembershipRole[]

  @@unique([userId, crunchId])
  @@index([crunchId])
  @@index([userId])
}

// Rol de pessoas da igreja - visitante, membro ou desligado. Independente de
// ter login no app: pessoa sem conta (so nome/email/telefone) e pessoa com
// conta (User) convivem na mesma lista, ligadas por userId quando aplicavel.
// Nao e o mesmo conceito que ChurchMembership (que so existe pra quem loga) -
// todo ChurchMembership ativo tem um RosterMember correspondente (sincronizado
// automaticamente), mas o contrario nao e verdade.
model RosterMember {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  // So dia/mes seria suficiente pro lembrete de aniversario, mas guardar a
  // data inteira e mais simples e nao impede o cron de olhar so dia/mes.
  birthDate DateTime?
  notes     String?

  // VISITOR | MEMBER | FORMER
  status   String    @default("VISITOR")
  // Quando virou membro / quando saiu - preenchidos pelas acoes de
  // promote/leave, nao editaveis direto. So guarda a ultima transicao,
  // nao um historico completo.
  joinedAt DateTime?
  leftAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  // Preenchido quando a pessoa tem login no app. Nulo pra quem nao tem.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([crunchId])
  @@index([crunchId, status])
}

model DailyVerse {
  id          String   @id @default(uuid())
  text        String
  reference   String
  commentary  String?
  // Quando true aparece na pagina publica da igreja. False nos versiculos
  // ja publicados - ninguem vira publico sem alguem marcar.
  isPublic    Boolean  @default(false)
  // Link de video (YouTube/Instagram) opcional.
  videoUrl    String?
  imageUrl    String?
  imageKey    String?
  publishedAt DateTime @default(now())

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([crunchId, publishedAt])
  @@index([crunchId, isPublic, publishedAt])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  pinned      Boolean   @default(false)
  isPublic    Boolean   @default(false)
  kind        String    @default("ANNOUNCEMENT")
  imageUrl    String?
  imageKey    String?
  // Link de video (YouTube/Instagram) opcional - mesmo padrao de
  // versiculo e devocional.
  videoUrl    String?
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([crunchId, isPublic, publishedAt])
}

model ServiceTime {
  id       String  @id @default(uuid())
  label    String
  weekday  Int
  time     String
  isActive Boolean @default(true)

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  messageRules MessageRule[]
  attendances  ServiceAttendance[]

  @@index([crunchId, isActive])
}

// Contagem manual de quem veio no culto - 1 registro por culto+data (unico
// juntos, entao lancar de novo no mesmo culto/dia edita em vez de duplicar).
// So numeros agregados (visitantes/membros), nao rastreia pessoa por pessoa -
// isso ja existe em outro lugar (RosterMember).
model ServiceAttendance {
  id           String   @id @default(uuid())
  date         DateTime
  visitorCount Int
  memberCount  Int
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  serviceTimeId String
  serviceTime   ServiceTime @relation(fields: [serviceTimeId], references: [id], onDelete: Cascade)

  @@unique([serviceTimeId, date])
  @@index([crunchId, date])
}

model Devotional {
  id          String   @id @default(uuid())
  title       String
  description String?
  // Mesma regra do versiculo: so aparece na pagina publica se marcado.
  isPublic    Boolean  @default(false)
  // Link de video (YouTube/Instagram) opcional.
  videoUrl    String?
  imageUrl    String?
  imageKey    String?
  publishedAt DateTime @default(now())

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  chapters   DevotionalChapter[]
  progresses DevotionalProgress[]
  comments   DevotionalComment[]

  @@index([crunchId, publishedAt])
  @@index([crunchId, isPublic, publishedAt])
}

model DevotionalChapter {
  id           String               @id @default(uuid())
  title        String
  content      String
  bibleRef     String?
  order        Int
  devotionalId String
  devotional   Devotional           @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
  progresses   DevotionalProgress[]
}

model DevotionalProgress {
  id            String            @id @default(uuid())
  updatedAt     DateTime          @updatedAt
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  devotionalId  String
  devotional    Devotional        @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
  lastChapterId String
  lastChapter   DevotionalChapter @relation(fields: [lastChapterId], references: [id], onDelete: Cascade)

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  @@unique([userId, devotionalId])
}

model DevotionalComment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())

  devotionalId String
  devotional   Devotional @relation(fields: [devotionalId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  @@index([devotionalId, createdAt])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  crunchId String?
  crunch   Crunch? @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([crunchId])
}

model AppNotification {
  id         String    @id @default(uuid())
  title      String
  body       String
  url        String?
  type       String?
  scheduleId String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model UserAuth {
  id String @id @default(uuid())

  groupId  String @unique @map("group_id")
  scopeId  String @unique @map("scope_id")
  clientId String @unique @map("client_id")
  secret   String

  createdAt DateTime @default(now()) @map("created_at")

  UserId String @unique @map("user_id")
  User   User   @relation(fields: [UserId], references: [id], onDelete: Cascade)

  @@map("tenant_auths")
}

model Department {
  id       String   @id @default(uuid())
  name     String
  type     String   @default("OTHER")
  isActive Boolean  @default(true)
  // Modulos ativos do ministerio (SONGS, RESOURCES, TASKS, CLASSES...).
  // Vazio nos registros ja existentes e tratado como "todos habilitados",
  // pra nao apagar aba de ministerio nenhum na migracao.
  modules  String[] @default([])

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  leaderId String
  leader   User   @relation("Leader", fields: [leaderId], references: [id])

  mediaItems MediaItem[]
  schedules  Schedule[]
  tasks      DepartmentTask[]
  members    UserDepartmentMembership[]
  roles      ChurchRole[]
}

model UserDepartmentMembership {
  id        String   @id @default(uuid())
  function  String?
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model UserUnavailableDate {
  id        String   @id @default(uuid())
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model DepartmentTask {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id])
}

model MediaItem {
  id       String @id @default(uuid())
  title    String
  url      String
  category String
  metadata Json?

  departmentId    String
  department      Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  schedules       ScheduleMediaItem[]
  userPreferences UserSongPreference[]
}

model UserSongPreference {
  id          String   @id @default(uuid())
  personalKey String?
  chords      String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaItemId])
}

// Anotacao pessoal e privada de um usuario sobre um capitulo da biblia.
// O texto biblico vem de uma API externa (bolls.life) e nao e persistido
// aqui - so a nota do usuario, chaveada por livro+capitulo (independente
// da versao/traducao escolhida).
model UserBibleNote {
  id         String   @id @default(uuid())
  bookAbbrev String
  chapter    Int
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookAbbrev, chapter])
}

model Schedule {
  id             String    @id @default(uuid())
  date           DateTime
  description    String
  rehearsalAt    DateTime?
  rehearsalNotes String?
  createdAt      DateTime  @default(now())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  assignments ScheduleAssignment[]
  mediaItems  ScheduleMediaItem[]
}

model ScheduleMediaItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  order     Int      @default(0)

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, mediaItemId])
}

model ScheduleAssignment {
  id                 String    @id @default(uuid())
  role               String
  viewedAt           DateTime?
  confirmationStatus String    @default("PENDING")
  confirmedAt        DateTime?
  attendanceStatus   String    @default("PENDING")
  attendedAt         DateTime?
  declineReason      String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

// --------------------------------------
// 5. HISTÓRICO (O Legado)
// --------------------------------------
model PastorMandate {
  id         String    @id @default(uuid())
  pastorId   String
  pastorName String
  startDate  DateTime
  endDate    DateTime?

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)
}

model PrayerRequest {
  id              String    @id @default(uuid())
  title           String
  body            String
  isAnonymous     Boolean   @default(false)
  isAnswered      Boolean   @default(false)
  status          String    @default("PENDING")
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([crunchId, createdAt])
  @@index([crunchId, status, createdAt])
}

// Tutorial anexado ao modal de ajuda de uma tela do app. pageKey e o
// path da rota (ex: "/scale", "/ministery") - o UtilsPageHelpButton busca
// pelo path atual, sem precisar mudar nenhuma pagina que ja usa o botao.
// contentType "VIDEO" usa videoUrl; "STEPS" usa steps (passo a passo
// imagem+texto, array de { order, imageUrl, imageKey, caption }). Exatamente
// um dos dois formatos e preenchido por linha - ver validacao no adapter.
model PageHelpVideo {
  id          String   @id @default(uuid())
  pageKey     String   @unique
  label       String
  description String?
  contentType String   @default("VIDEO")
  videoUrl    String?
  steps       Json?
  updatedAt   DateTime @updatedAt
}

// Modelo reutilizavel de mensagem de WhatsApp. {nome} no body e substituido
// pelo nome do RosterMember na hora do envio. Sem publico fixo - o publico
// (visitante/membro/todos) e escolhido no envio manual ou na regra.
model MessageTemplate {
  id        String   @id @default(uuid())
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  rules            MessageRule[]
  logs             MessageLog[]
  birthdaySettings BirthdayMessageSetting[]

  @@index([crunchId])
}

// Regra de envio automatico recorrente, ligada a um ServiceTime ja
// cadastrado. Dispara offsetMinutes depois do horario do culto. lastFiredAt
// guarda a ultima vez que disparou, pra o scheduler nao mandar duas vezes na
// mesma semana.
model MessageRule {
  id            String    @id @default(uuid())
  // VISITOR | MEMBER | ALL
  audience      String
  offsetMinutes Int
  isActive      Boolean   @default(true)
  lastFiredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  serviceTimeId String
  serviceTime   ServiceTime @relation(fields: [serviceTimeId], references: [id], onDelete: Cascade)

  templateId String
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  logs MessageLog[]

  @@index([crunchId, isActive])
}

// Historico de envios (manual ou disparado por MessageRule). Contagem
// agregada, nao rastreia entrega por destinatario individual. templateId
// nulo sobrevive a delete do template - so perde o nome/corpo exatos usados,
// nao o registro do envio em si.
model MessageLog {
  id           String    @id @default(uuid())
  // VISITOR | MEMBER | ALL
  audience     String
  // PROCESSING | DONE
  status       String    @default("PROCESSING")
  totalCount   Int       @default(0)
  successCount Int       @default(0)
  failedCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  crunchId String
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  ruleId String?
  rule   MessageRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([crunchId, createdAt])
}

// 1 linha por igreja, criada sob demanda pelo scheduler de aniversario na
// primeira vez que ha aniversariante do dia - mesmo com isActive false, o
// registro guarda lastNotifiedAt pra nao notificar o pastor duas vezes no
// mesmo dia. isActive liga o disparo automatico de WhatsApp (alem da
// notificacao push, que sempre acontece); sem isso, so avisa o pastor.
model BirthdayMessageSetting {
  id             String    @id @default(uuid())
  isActive       Boolean   @default(false)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  crunchId String @unique
  crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

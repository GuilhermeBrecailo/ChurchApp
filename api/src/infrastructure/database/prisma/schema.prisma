generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Crunch {
    id         String   @id @default(uuid())
    name       String
    slug       String   @unique
    userMainId String?
    logo       String?
    accentColor String?
    isActive   Boolean  @default(true)
    createdAt  DateTime @default(now())

    city         String
    road         String
    localZipCode String
    state        String
    complement   String?
    number       String?

    document String?
    isDemoChurch Boolean @default(false)

    inviteCode    String?  @unique

    users         User[]
    memberships   ChurchMembership[]
    departments   Department[]
    pastorHistory PastorMandate[]
    churchRoles   ChurchRole[]
    dailyVerses   DailyVerse[]
    announcements Announcement[]
    serviceTimes  ServiceTime[]
    devotionals Devotional[]
    devotionalProgresses DevotionalProgress[]
    prayerRequests PrayerRequest[]
    pushSubscriptions PushSubscription[]
}

model ChurchRole {
    id          String   @id @default(uuid())
    name        String
    description String?
    permissions String[]
    createdAt   DateTime @default(now())

    crunchId String
    crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

    users       User[]
    memberships ChurchMembership[]
}

model User {
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    phone     String?
    role      String   @default("MEMBER")
    createdAt DateTime @default(now())
    canManageMembers Boolean @default(false)
    mustChangePassword Boolean @default(false)
    isDemoUser   Boolean @default(false)
    profileSuggestion String?

    crunchId String?
    crunch   Crunch? @relation(fields: [crunchId], references: [id])

    churchRoleId String?
    churchRole   ChurchRole? @relation(fields: [churchRoleId], references: [id], onDelete: SetNull)

    churchMemberships ChurchMembership[]
    ledDepartments Department[]         @relation("Leader")
    assignments    ScheduleAssignment[]
    departmentTasks DepartmentTask[]
    departmentMemberships UserDepartmentMembership[]
    unavailableDates UserUnavailableDate[]
    userAuth       UserAuth?
    pushSubscriptions PushSubscription[]
    songPreferences UserSongPreference[]
    notifications AppNotification[]
    dailyVerses DailyVerse[]
    announcements Announcement[]
    devotionals Devotional[]
    devotionalProgresses DevotionalProgress[]
    prayerRequests PrayerRequest[]
}

model ChurchMembership {
    id               String   @id @default(uuid())
    role             String   @default("MEMBER")
    canManageMembers Boolean  @default(false)
    isPrimary        Boolean  @default(false)
    isActive         Boolean  @default(true)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    userId String
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    crunchId String
    crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

    churchRoleId String?
    churchRole   ChurchRole? @relation(fields: [churchRoleId], references: [id], onDelete: SetNull)

    @@unique([userId, crunchId])
    @@index([crunchId])
    @@index([userId])
}

model DailyVerse {
    id          String   @id @default(uuid())
    text        String
    reference   String
    commentary  String?
    // Link de video (YouTube/Instagram) opcional. Nulo nos versiculos ja
    // existentes - upload de arquivo fica pra uma etapa posterior.
    videoUrl    String?
    publishedAt DateTime @default(now())

    crunchId String
    crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

    authorId String
    author   User   @relation(fields: [authorId], references: [id])

    @@index([crunchId, publishedAt])
}

model Announcement {
    id          String   @id @default(uuid())
    title       String
    body        String
    pinned      Boolean  @default(false)
    isPublic    Boolean  @default(false)
    kind        String   @default("ANNOUNCEMENT")
    publishedAt DateTime @default(now())
    expiresAt   DateTime?

    crunchId String
    crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

    authorId String
    author   User   @relation(fields: [authorId], references: [id])

    @@index([crunchId, isPublic, publishedAt])
}

model ServiceTime {
    id       String  @id @default(uuid())
    label    String
    weekday  Int
    time     String
    isActive Boolean @default(true)

    crunchId String
    crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

    @@index([crunchId, isActive])
}

model Devotional {
    id          String   @id @default(uuid())
    title       String
    description String?
    // Link de video (YouTube/Instagram) opcional. Nulo nos devocionais ja
    // existentes - upload de arquivo fica pra uma etapa posterior.
    videoUrl    String?
    publishedAt DateTime @default(now())

    crunchId String
    crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

    authorId String
    author   User   @relation(fields: [authorId], references: [id])

    chapters   DevotionalChapter[]
    progresses DevotionalProgress[]

    @@index([crunchId, publishedAt])
}

model DevotionalChapter {
    id           String @id @default(uuid())
    title        String
    content      String
    bibleRef     String?
    order        Int
    devotionalId String
    devotional   Devotional @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
    progresses   DevotionalProgress[]
}

model DevotionalProgress {
    id            String   @id @default(uuid())
    updatedAt     DateTime @updatedAt
    userId        String
    user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    devotionalId  String
    devotional    Devotional @relation(fields: [devotionalId], references: [id], onDelete: Cascade)
    lastChapterId String
    lastChapter   DevotionalChapter @relation(fields: [lastChapterId], references: [id], onDelete: Cascade)

    crunchId String
    crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

    @@unique([userId, devotionalId])
}

model PushSubscription {
    id        String   @id @default(uuid())
    endpoint  String   @unique
    p256dh    String
    auth      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    userId String?
    user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

    crunchId String?
    crunch   Crunch? @relation(fields: [crunchId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([crunchId])
}

model AppNotification {
    id        String   @id @default(uuid())
    title     String
    body      String
    url       String?
    type      String?
    scheduleId String?
    readAt    DateTime?
    createdAt DateTime @default(now())

    userId String
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, readAt, createdAt])
}

model UserAuth {
    id String @id @default(uuid())

    groupId  String @unique @map("group_id")
    scopeId  String @unique @map("scope_id")
    clientId String @unique @map("client_id")
    secret   String

    createdAt DateTime @default(now()) @map("created_at")

    UserId String @unique @map("user_id")
    User   User   @relation(fields: [UserId], references: [id], onDelete: Cascade)

    @@map("tenant_auths")
}

model Department {
    id       String  @id @default(uuid())
    name     String
    type     String  @default("OTHER")
    isActive Boolean @default(true)

    crunchId String
    crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

    leaderId String
    leader   User   @relation("Leader", fields: [leaderId], references: [id])

    mediaItems MediaItem[]
    schedules  Schedule[]
    tasks      DepartmentTask[]
    members    UserDepartmentMembership[]
}

model UserDepartmentMembership {
    id        String  @id @default(uuid())
    function  String?
    isPrimary Boolean @default(true)
    canManageSchedule Boolean @default(false)
    createdAt DateTime @default(now())

    userId String
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    departmentId String
    department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

    @@unique([userId, departmentId])
}

model UserUnavailableDate {
    id        String   @id @default(uuid())
    date      DateTime
    reason    String?
    createdAt DateTime @default(now())

    userId String
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, date])
}

model DepartmentTask {
    id          String   @id @default(uuid())
    title       String
    description String?
    status      String   @default("OPEN")
    priority    String   @default("MEDIUM")
    dueDate     DateTime?
    createdAt   DateTime @default(now())

    departmentId String
    department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

    assigneeId String?
    assignee   User? @relation(fields: [assigneeId], references: [id])
}

model MediaItem {
    id       String @id @default(uuid())
    title    String
    url      String
    category String
    metadata Json?

    departmentId String
    department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
    schedules    ScheduleMediaItem[]
    userPreferences UserSongPreference[]
}

model UserSongPreference {
    id          String   @id @default(uuid())
    personalKey String?
    chords      String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    userId String
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    mediaItemId String
    mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

    @@unique([userId, mediaItemId])
}

model Schedule {
    id          String   @id @default(uuid())
    date        DateTime
    description String
    rehearsalAt DateTime?
    rehearsalNotes String?

    departmentId String
    department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

    assignments ScheduleAssignment[]
    mediaItems  ScheduleMediaItem[]
}

model ScheduleMediaItem {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())
    order     Int      @default(0)

    scheduleId String
    schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

    mediaItemId String
    mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

    @@unique([scheduleId, mediaItemId])
}

model ScheduleAssignment {
    id   String @id @default(uuid())
    role String
    viewedAt DateTime?
    confirmationStatus String @default("PENDING")
    confirmedAt DateTime?
    attendanceStatus String @default("PENDING")
    attendedAt DateTime?
    declineReason String?

    userId String
    user   User   @relation(fields: [userId], references: [id])

    scheduleId String
    schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

// --------------------------------------
// 5. HISTÓRICO (O Legado)
// --------------------------------------
model PastorMandate {
    id         String    @id @default(uuid())
    pastorId   String
    pastorName String
    startDate  DateTime
    endDate    DateTime?

    crunchId String
    crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)
}

model PrayerRequest {
    id          String   @id @default(uuid())
    title       String
    body        String
    isAnonymous Boolean  @default(false)
    isAnswered  Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    crunchId String
    crunch   Crunch @relation(fields: [crunchId], references: [id], onDelete: Cascade)

    userId String
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([crunchId, createdAt])
}

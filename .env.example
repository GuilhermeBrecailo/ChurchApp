# Database
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=5433
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5433/your_db_name?schema=public"

# API / Web
API_PORT=8000
WEB_PORT=3000
NODE_ENV=development

NUXT_PUBLIC_URL_BACKEND=http://localhost:8000

# Dominio do cookie de refresh_token (ex: .seudominio.com em producao).
# Deve ser um dominio pai comum entre o front e a API - se front e API
# ficarem em dominios registraveis diferentes (ex: front.com e api.outro.com),
# o cookie vira cross-site "de verdade" e navegadores como Safari/Chrome
# mobile podem bloquear ou descartar ele, derrubando o login prematuramente.
# Deixe em branco em dev local (cookie host-only).
REFRESH_COOKIE_DOMAIN=

# Push notifications (Web Push / PWA)
# Generate development keys with: npx --prefix api web-push generate-vapid-keys --json
# Keep VAPID_PRIVATE_KEY secret in real deployments.
VAPID_PUBLIC_KEY=change_me
VAPID_PRIVATE_KEY=change_me
VAPID_SUBJECT=mailto:admin@appquadrangular.local

# Keycloak
KEYCLOAK_CLIENT_UUID=your_keycloak_client_uuid
KEYCLOAK_USER=your_keycloak_admin_user
KEYCLOAK_PASSWORD=your_keycloak_admin_password
KEYCLOAK_GRANT_TYPE=password
KEYCLOAK_SECRET_KEY=your_keycloak_client_secret
KEYCLOAK_REALM=your_keycloak_realm
KEYCLOAK_CLIENT_USER_ID=your_keycloak_client_user_id
KEYCLOAK_CLIENT_ID=your_keycloak_client_id
KEYCLOAK_ADMIN_REALM=your_keycloak_admin_realm

# Tenant
TENANT_ID="your_tenant_id"

# Mercado Pago billing
MERCADOPAGO_ACCESS_TOKEN=TEST-your-mercado-pago-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-mercado-pago-webhook-secret
MERCADOPAGO_WEBHOOK_URL=https://api.yourdomain.com/public/mercadopago/webhook
MERCADOPAGO_PRO_MONTHLY_AMOUNT=49.90
MERCADOPAGO_CURRENCY_ID=BRL
MERCADOPAGO_CHECKOUT_BACK_URL=https://app.yourdomain.com/billing

# WhatsApp alerts / business digest (Baileys, self-hosted - no Business API)
# Number that receives ad-hoc alerts (whatsapp:alert) and the daily
# business digest (whatsapp:business-digest). Digits only, with country
# code, e.g. 5511999998888. Requires a one-time `npm run whatsapp:setup`
# to authenticate the session (QR/pairing code) before either script works.
WHATSAPP_ALERT_NUMBER=5511999998888

# Microservico de WhatsApp por igreja (microservice-whatsapp, Baileys +
# RabbitMQ, roda como stack separada - ver docker-compose.prod.yml daquele
# projeto). Cada igreja tem sua propria sessao/conexao; nao confundir com
# WHATSAPP_ALERT_NUMBER acima, que e so pro numero pessoal do dev.
WHATSAPP_SERVICE_URL=http://localhost:3060
WHATSAPP_GATEWAY_SECRET=your_whatsapp_gateway_secret

# Prospecção de leads (npm run leads:find, api/scripts/find-church-leads.ts)
# Chave da Google Places API - console.cloud.google.com, ativar "Places API"
# e billing (tem cota gratuita mensal). Só traz dado que a própria igreja
# publicou no Google Business Profile (nome/telefone/endereço/site) - a
# lista sai em CSV pra contato manual, o script não envia nada sozinho.
GOOGLE_PLACES_API_KEY=

# Instagram Business Login (Instagram API with Instagram Login)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=https://api.churchapp.site/public/integrations/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic
INSTAGRAM_GRAPH_API_VERSION=v26.0
# Use uma chave longa e exclusiva para criptografar tokens do Instagram em repouso.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=change_me_to_a_long_random_secret

